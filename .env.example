# Database (required — no localhost fallback)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=nodo_ai
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSLMODE=require

# Auth (required by app)
JWT_SECRET=your-jwt-secret
ALGORITHM=HS256

# Backend base URL (used for OnlyOffice callback URL)
BACKEND_BASE_URL=http://your-backend-host:8000

# AWS S3 (document storage)
AWS_REGION=your-aws-region
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-private-bucket-name
S3_SIGNED_URL_EXPIRY=3600

# OnlyOffice (single secret used for signing configs and verifying callbacks)
ONLYOFFICE_SECRET=asdf1234!@yash-dev
ONLYOFFICE_DS_URL=http://localhost:8080

# OCR (optional — leave unset to disable)
# TESSERACT_CMD=/usr/bin/tesseract
