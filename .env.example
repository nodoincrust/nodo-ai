# Database (required — no localhost fallback)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=nodo_ai
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSLMODE=require

# Auth (required by app)
JWT_SECRET=your-jwt-secret
ALGORITHM=HS256

# OnlyOffice (optional — defaults exist in code)
ONLYOFFICE_SECRET=asdf1234!@yash-dev
ONLYOFFICE_DS_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=onlyoffice-secret-key

# OCR (optional — leave unset to disable)
# TESSERACT_CMD=/usr/bin/tesseract
