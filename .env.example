# Database (required — no localhost fallback)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=nodo_ai
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSLMODE=require

# Auth (required by app)
JWT_SECRET=your-jwt-secret
ALGORITHM=HS256

# Backend base URL (used for OnlyOffice callback URL)
BACKEND_BASE_URL=http://your-backend-host:8000

# AWS S3 (document storage)
AWS_REGION=your-aws-region
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-private-bucket-name
S3_SIGNED_URL_EXPIRY=3600

# OnlyOffice (single secret used for signing configs and verifying callbacks)
ONLYOFFICE_SECRET=asdf1234!@yash-dev
ONLYOFFICE_DS_URL=http://localhost:8080

# OCR (optional — leave unset to disable)
# TESSERACT_CMD=/usr/bin/tesseract

# Ollama (all optional — the defaults below are what the code uses)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b-instruct-q4_0
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_EMBED_TIMEOUT=120
# How long Ollama keeps the model resident. Short values mean every request
# after a lull pays a cold load from disk.
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_TIMEOUT=120
# OLLAMA_NUM_PREDICT=512
# OLLAMA_TEMPERATURE=0.4
# Threads per generation. 0 lets Ollama match the host's core count.
# OLLAMA_NUM_THREAD=0
# Generations allowed to run at once. Raise only if the box has cores to spare.
# OLLAMA_MAX_CONCURRENCY=2
# Hard cap on context sent to the model, in characters.
# OLLAMA_CONTEXT_CHARS=12000

# Redis (embedding cache)
# REDIS_HOST=localhost
# REDIS_PORT=6379
